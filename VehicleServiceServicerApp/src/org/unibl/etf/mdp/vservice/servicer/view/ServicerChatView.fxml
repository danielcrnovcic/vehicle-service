<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.unibl.etf.mdp.vservice.servicer.controller.ServicerChatViewController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <Label text="Serviser - Chat Panel">
        <font>
            <Font size="24.0" />
        </font>
    </Label>
    <VBox prefHeight="200.0" prefWidth="100.0" VBox.vgrow="ALWAYS">
        <TextArea fx:id="chatArea" editable="false" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
        <HBox alignment="CENTER_LEFT" prefHeight="30.0" prefWidth="200.0" spacing="10.0">
            <padding>
                <Insets top="10.0" />
            </padding>
            <Label text="Tip poruke:" />
            <ComboBox fx:id="messageTypeComboBox" prefWidth="150.0" promptText="Odgovori klijentu" />
            <Label fx:id="recipientLabel" text="Klijent:" visible="false" />
            <TextField fx:id="recipientField" prefWidth="200.0" promptText="Korisničko ime klijenta" visible="false" />
        </HBox>
        <HBox alignment="CENTER_LEFT" prefHeight="30.0" prefWidth="200.0" spacing="10.0">
            <TextField fx:id="chatMessageField" HBox.hgrow="ALWAYS" />
            <Button onAction="#handleSendMessageAction" text="Pošalji" />
        </HBox>
    </VBox>
</VBox>