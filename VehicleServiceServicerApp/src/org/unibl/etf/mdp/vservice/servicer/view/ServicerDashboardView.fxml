<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.unibl.etf.mdp.vservice.servicer.controller.ServicerDashboardViewController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
   <children>
       <Label text="Kontrolna tabla servisera">
           <font>
               <Font size="24.0" />
           </font>
       </Label>
       <TabPane fx:id="mainTabPane" prefHeight="200.0" prefWidth="200.0" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
          <tabs>
              <Tab text="Upravljanje klijentima">
                  <content>
                      <VBox spacing="10.0">
                         <children>
                             <Label text="Lista klijenata">
                                 <font>
                                     <Font size="18.0" />
                                 </font>
                             </Label>
                             <TableView fx:id="clientsTable" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                                 <columns>
                                     <TableColumn fx:id="clientUsernameColumn" prefWidth="100.0" text="Korisničko ime" />
                                     <TableColumn fx:id="clientFirstNameColumn" prefWidth="100.0" text="Ime" />
                                     <TableColumn fx:id="clientLastNameColumn" prefWidth="100.0" text="Prezime" />
                                     <TableColumn fx:id="clientStatusColumn" prefWidth="80.0" text="Status" />
                                 </columns>
                                 <columnResizePolicy>
                                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                             </TableView>
                             <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <children>
                                    <Button onAction="#handleApproveClientAction" text="Odobri registraciju" />
                                    <Button onAction="#handleBlockClientAction" text="Blokiraj korisnika" />
                                    <Button onAction="#handleDeleteClientAction" text="Obriši korisnika" />
                                    <Button mnemonicParsing="false" onAction="#openChatWindow" text="Chat" />
                                </children>
                             </HBox>
                         </children>
                      </VBox>
                  </content>
              </Tab>
              <Tab text="Upravljanje terminima">
                  <content>
                      <VBox spacing="10.0">
                         <children>
                             <Label text="Lista zakazanih termina">
                                 <font>
                                     <Font size="18.0" />
                                 </font>
                             </Label>
                             <TableView fx:id="appointmentsTable" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                                 <columns>
                                     <TableColumn fx:id="apptUserIdColumn" prefWidth="100.0" text="Korisnik" />
                                     <TableColumn fx:id="apptDateTimeColumn" prefWidth="150.0" text="Datum i Vrijeme" />
                                     <TableColumn fx:id="apptServiceTypeColumn" prefWidth="120.0" text="Vrsta Usluge" />
                                     <TableColumn fx:id="apptStatusColumn" prefWidth="100.0" text="Status" />
                                     <TableColumn fx:id="apptCommentColumn" prefWidth="250.0" text="Komentar Servisera" />
                                     <TableColumn fx:id="apptUsedPartsSummaryColumn" prefWidth="150.0" text="Utrošeni dijelovi" />
                                 </columns>
                                 <columnResizePolicy>
                                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                             </TableView>
                             <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <children>
                                    <Button onAction="#handleApproveAppointmentAction" text="Potvrdi zahtjev" />
                                    <Button onAction="#handleRejectAppointmentAction" text="Odbij zahtjev" />
                                    <TextField fx:id="appointmentCommentField" prefWidth="200.0" promptText="Dodaj komentar..." />
                                    <Button onAction="#handleAddCommentAction" text="Dodaj komentar" />
                                    <Button onAction="#handleCreateInvoiceAction" text="Kreiraj i pošalji fakturu" />
                                </children>
                             </HBox>
         
                             <Separator orientation="HORIZONTAL" prefWidth="200.0" />
                             <Label text="Dodavanje utrošenih dijelova za odabrani termin">
                                 <font>
                                     <Font size="16.0" />
                                 </font>
                             </Label>
                             <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <children>
                                    <ComboBox fx:id="partComboBox" prefWidth="200.0" promptText="Odaberi dio" />
                                    <TextField fx:id="partQuantityUsedField" prefWidth="80.0" promptText="Količina" />
                                    <Button onAction="#handleAddPartToAppointmentAction" text="Dodaj dio u termin" />
                                    <Button onAction="#handleCompleteServiceAction" text="Završi servis i spremi dijelove" />
                                </children>
                             </HBox>
         
                             <Label text="Utrošeni dijelovi za odabrani termin:">
                                 <font>
                                     <Font size="14.0" />
                                 </font>
                             </Label>
                             <TableView fx:id="usedPartsTable" prefHeight="150.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                                 <columns>
                                     <TableColumn fx:id="usedPartCodeColumn" prefWidth="100.0" text="Šifra" />
                                     <TableColumn fx:id="usedPartNameColumn" prefWidth="150.0" text="Naziv" />
                                     <TableColumn fx:id="usedPartQuantityColumn" prefWidth="80.0" text="Količina" />
                                     <TableColumn fx:id="usedPartRemoveColumn" prefWidth="50.0" text="Ukloni" />
                                 </columns>
                                 <columnResizePolicy>
                                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                             </TableView>
                         </children>
                      </VBox>
                  </content>
              </Tab>
              <Tab text="Upravljanje dijelovima">
                  <content>
                      <VBox spacing="10.0">
                         <children>
                             <Label text="Administracija dijelova">
                                 <font>
                                     <Font size="18.0" />
                                 </font>
                             </Label>
                             <GridPane hgap="10.0" vgap="5.0">
                                 <columnConstraints>
                                     <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                     <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                                     <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                     <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                                 </columnConstraints>
                                 <rowConstraints>
                                     <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                     <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                     <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                     <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                 </rowConstraints>
                                <children>
                                    <Label text="Šifra:">
                                        <font>
                                            <Font size="12.0" />
                                        </font>
                                    </Label>
                                    <TextField fx:id="partCodeField" GridPane.columnIndex="1" />
                                    <Label text="Naziv:" GridPane.rowIndex="1">
                                        <font>
                                            <Font size="12.0" />
                                        </font>
                                    </Label>
                                    <TextField fx:id="partNameField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    <Label text="Proizvođač:" GridPane.rowIndex="2">
                                        <font>
                                            <Font size="12.0" />
                                        </font>
                                    </Label>
                                    <TextField fx:id="partManufacturerField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    <Label text="Cijena:" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                        <font>
                                            <Font size="12.0" />
                                        </font>
                                    </Label>
                                    <TextField fx:id="partPriceField" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                                    <Label text="Količina:" GridPane.columnIndex="2" GridPane.rowIndex="1">
                                        <font>
                                            <Font size="12.0" />
                                        </font>
                                    </Label>
                                    <TextField fx:id="partQuantityField" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                                    <Label text="Opis:" GridPane.rowIndex="3">
                                        <font>
                                            <Font size="12.0" />
                                        </font>
                                    </Label>
                                    <TextArea fx:id="partDescriptionArea" prefHeight="70.0" prefWidth="200.0" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="3" />
                                </children>
                             </GridPane>
                             <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <children>
                                    <Button onAction="#handleAddPartAction" text="Dodaj dio" />
                                    <Button onAction="#handleUpdatePartAction" text="Ažuriraj dio" />
                                    <Button onAction="#handleDeletePartAction" text="Obriši dio" />
                                    <Button onAction="#openOrderWindow" text="Naruči dio" />
                                </children>
                             </HBox>
                             <TableView fx:id="partsTable" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                                 <columns>
                                     <TableColumn fx:id="partCodeColumn" prefWidth="75.0" text="Šifra" />
                                     <TableColumn fx:id="partNameColumn" prefWidth="120.0" text="Naziv" />
                                     <TableColumn fx:id="partManufacturerColumn" prefWidth="120.0" text="Proizvođač" />
                                     <TableColumn fx:id="partPriceColumn" prefWidth="80.0" text="Cijena" />
                                     <TableColumn fx:id="partQuantityColumn" prefWidth="80.0" text="Količina" />
                                     <TableColumn fx:id="partDescriptionColumn" prefWidth="250.0" text="Opis" />
                                 </columns>
                                 <columnResizePolicy>
                                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                             </TableView>
                         </children>
                      </VBox>
                  </content>
              </Tab>
          </tabs>
       </TabPane>
   </children>
</VBox>
